{
    "name": "tomvondracek/bolt-sitemap",
    "description": "Bolt CMS extension that serves a spec-compliant XML sitemap index: per-locale hreflang, slugless singletons, static routes, images, removal-aware lastmod, ETag caching and no XSLT.",
    "type": "bolt-extension",
    "license": "MIT",
    "keywords": ["bolt", "bolt-extension", "sitemap", "xml-sitemap", "hreflang", "seo", "twig"],
    "authors": [
        {
            "name": "Tomáš Vondráček",
            "email": "tomasvondrac@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "symfony/polyfill-intl-idn": "^1.43",
        "symfony/polyfill-php84": "^1.43",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "bolt/core": "^6.1.10",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.2.16",
        "phpstan/phpstan-deprecation-rules": "2.0.5",
        "phpunit/phpunit": "^11.5.57",
        "rector/rector": "2.6.7",
        "symplify/easy-coding-standard": "^13.3.11",
        "phpstan/phpstan-phpunit": "2.0.21",
        "phpstan/phpstan-strict-rules": "2.0.12",
        "appolodev/bolt-seo": "^2.3"
    },
    "suggest": {
        "appolodev/bolt-seo": "Pages editors mark noindex or give another canonical URL in bolt-seo are left out of the sitemap, so the sitemap never contradicts the pages' own robots and canonical tags."
    },
    "conflict": {
        "bolt/core": "<6.0 || >=7.0",
        "bolt/sitemap-extension": "*"
    },
    "autoload": {
        "psr-4": {
            "Tomvondracek\\Sitemap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomvondracek\\Sitemap\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "entrypoint": "Tomvondracek\\Sitemap\\Extension"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "drupol/composer-packages": false,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        }
    }
}
